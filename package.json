{
  "name": "dolly",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/studio/tsconfig.json --noEmit",
    "build:site": "bun build site/src/camera.ts --format iife --outfile site/js/camera.js",
    "build:cli": "bun build packages/cli/src/main.ts --compile --outfile .build/dolly"
  },
  "devDependencies": {
    "@types/bun": "1.1.14",
    "typescript": "5.6.3",
    "@types/node": "22.10.2"
  }
}
